{
  "name": "perplexica-monorepo",
  "version": "1.11.0-rc3",
  "private": true,
  "license": "MIT",
  "author": "ItzCrazyKns",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mcp": "bun run --filter=@perplexica/mcp-server dev",
    "dev:all": "npm run dev & npm run dev:mcp",
    "build": "npm run db:migrate && next build",
    "build:mcp": "bun run --filter=@perplexica/mcp-server build",
    "start": "next start",
    "start:mcp": "bun run --filter=@perplexica/mcp-server start",
    "lint": "next lint",
    "format:write": "prettier . --write",
    "db:migrate": "tsx ./src/lib/db/migrate.ts",
    "mcp:server": "bun run --filter=@perplexica/mcp-server start:stdio",
    "mcp:dev": "bun run --filter=@perplexica/mcp-server dev",
    "mcp:http-server": "bun run --filter=@perplexica/mcp-server start",
    "research:vbee": "tsx vbee-research-runner.ts",
    "research:vbee:direct": "tsx vbee-research-direct.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.931.0",
    "@headlessui/react": "^2.2.0",
    "@headlessui/tailwindcss": "^0.2.2",
    "@iarna/toml": "^2.2.5",
    "@icons-pack/react-simple-icons": "^12.3.0",
    "@langchain/anthropic": "^0.3.24",
    "@langchain/aws": "^1.0.1",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "@langchain/google-genai": "^0.2.15",
    "@langchain/groq": "^0.2.3",
    "@langchain/ollama": "^0.2.3",
    "@langchain/openai": "^0.6.2",
    "@langchain/textsplitters": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@smithy/eventstream-codec": "^4.2.5",
    "@smithy/protocol-http": "^5.3.5",
    "@smithy/signature-v4": "^5.3.5",
    "@smithy/util-utf8": "^4.2.0",
    "@tailwindcss/typography": "^0.5.12",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.8.3",
    "better-sqlite3": "^11.9.1",
    "clsx": "^2.1.0",
    "compute-cosine-similarity": "^1.1.0",
    "compute-dot": "^1.1.0",
    "drizzle-orm": "^0.40.1",
    "html-to-text": "^9.0.5",
    "jspdf": "^3.0.1",
    "langchain": "^0.3.30",
    "lucide-react": "^0.363.0",
    "mammoth": "^1.9.1",
    "markdown-to-jsx": "^7.7.2",
    "next": "^15.2.2",
    "next-themes": "^0.3.0",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "react-text-to-speech": "^0.14.5",
    "react-textarea-autosize": "^8.5.3",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.2.2",
    "vm2": "^3.10.0",
    "winston": "^3.17.0",
    "yet-another-react-lightbox": "^3.17.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/html-to-text": "^9.0.4",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.30.5",
    "eslint": "^8",
    "eslint-config-next": "14.1.4",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
